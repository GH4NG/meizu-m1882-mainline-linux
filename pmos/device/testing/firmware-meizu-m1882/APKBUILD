maintainer="GH4NG <gh4ng@users.noreply.github.com>"
pkgname=firmware-meizu-m1882
pkgver=1
pkgrel=0
pkgdesc="Firmware for Meizu 16th"
url="https://github.com/GH4NG/meizu-m1882-mainline-linux"
arch="aarch64"
depends="linux-firmware-qcom"
license="MIT"
source="
	firmware-initramfs.files
	rmtfs.service.conf
	usr-lib-firmware-qcom-sdm845-Meizu-m1882.mount
	"
options="!archcheck !check !strip !tracedeps"

package() {
	install -Dm644 "$srcdir"/firmware-initramfs.files \
		"$pkgdir"/usr/share/mkinitfs/files/"$pkgname".files

	install -Dm644 "$srcdir"/usr-lib-firmware-qcom-sdm845-Meizu-m1882.mount \
		"$pkgdir"/usr/lib/systemd/system/usr-lib-firmware-qcom-sdm845-Meizu-m1882.mount
	install -Dm644 "$srcdir"/rmtfs.service.conf \
		"$pkgdir"/usr/lib/systemd/system/rmtfs.service.d/meizu-m1882-firmware.conf
	install -d "$pkgdir"/usr/lib/firmware/qcom/sdm845/Meizu/m1882
	
	ln -s Meizu/m1882/image/mba.mbn \
		"$pkgdir"/usr/lib/firmware/qcom/sdm845/mba.mbn
	ln -s Meizu/m1882/image/modem.mdt \
		"$pkgdir"/usr/lib/firmware/qcom/sdm845/modem.mbn
	for _segment in \
		00 01 02 03 04 05 06 07 08 09 10 11 12 13 \
		15 16 17 18 20 21 22 23 24 25 26 27 28; do
		ln -s Meizu/m1882/image/modem.b$_segment \
			"$pkgdir"/usr/lib/firmware/qcom/sdm845/modem.b$_segment
	done
	install -d "$pkgdir"/usr/lib/firmware/ath10k/WCN3990/hw1.0
	ln -s /usr/lib/firmware/qcom/sdm845/Meizu/m1882/image/bdwlan.bin \
		"$pkgdir"/usr/lib/firmware/ath10k/WCN3990/hw1.0/board.bin
}

sha512sums="
